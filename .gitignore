# Environnement Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.*
# Configuration sensible
.env
.streamlit/secrets.toml

# Données de production (jamais dans le repo)
runs/
data/copies/
data/outputs/

# Préférences de modèles IA — config d'exploitation, propre à chaque instance
# (éditée depuis Paramètres → Modèles IA, D-CEO-44). Le repli est dans .env.
data/preferences_modeles.json

# Corpus de référence (module 3).
#
# Les fichiers `corpus_*.yaml` SONT versionnés, à une condition tenue par
# construction : ils n'emploient que des identifiants non nominatifs
# (CORPUS-3E-01…). Aucun nom, aucun établissement, aucun téléphone — les
# justifications citent la production de l'élève, jamais son identité.
#
# Ce sont eux l'étalon du module 4 : les laisser hors du dépôt reviendrait à
# faire reposer la seule mesure objective du dispositif sur un disque unique.
# Tout le reste du dossier (scans, brouillons, exports) reste exclu.
data/corpus/*
!data/corpus/exemple.yaml
!data/corpus/corpus_*.yaml
*.pdf
!docs/*.pdf

# Logs applicatifs (peuvent contenir des noms d'élèves — données personnelles)
logs/

# Google Sheets — clé de compte de service (secret, jamais versionné)
credentials/

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Fichiers temporaires Microsoft Office
~$*
desktop.ini

# Tests
.pytest_cache/
.coverage
htmlcov/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Claude Code (local uniquement)
.claude/settings.local.json

# Django
staticfiles/
*.sqlite3
*.db
