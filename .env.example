# Hakili Lab — Configuration environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# Ne commitez JAMAIS le fichier .env

# ── Anthropic Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Modèles Claude ─────────────────────────────────────────────────────────────
# HEAVY = « variante Sonnet », OPUS = « variante Opus » du sélecteur
# Paramètres → Modèles IA (src/core/preferences_modeles.py, D-CEO-44).
CLAUDE_MODEL_HEAVY=claude-sonnet-5
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_OPUS=claude-opus-5

# ── Google Gemini — transcription vision ($0 jusqu'à 1M tokens/jour) ──────────
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── DeepSeek — correction (V3) + diagnostic (R1) + remédiation ───────────────
# Clé : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Mistral — diagnostic + remédiation en français académique ────────────────
# Clé : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ── OpenAI — filet de secours GPT-5 (transcription, nom élève, correction,
# diagnostic, remédiation) ────────────────────────────────────────────────────
# Clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Choix des providers par étape ────────────────────────────────────────────
# Défauts de repli. La config effective vit dans data/preferences_modeles.json,
# éditée depuis Paramètres → Modèles IA (admin) et PRIME sur ces valeurs (D-CEO-44).
VISION_PROVIDER=gemini         # "claude" | "gemini" | "openai"
GRADING_PROVIDER=deepseek      # "deepseek" | "claude" | "gemini"
DIAGNOSTIC_PROVIDER=claude     # "gemini" | "claude" | "openai" | "deepseek"

# ── Seuils pipeline ────────────────────────────────────────────────────────────
CONFIDENCE_REVIEW_THRESHOLD=0.75
IMAGE_MIN_RESOLUTION=1000
IMAGE_BLUR_THRESHOLD=100.0

# ── Stockage local ─────────────────────────────────────────────────────────────
RUNS_DIR=./runs
SUBJECT=mathematics

# ── Google Sheets — source de vérité élèves/personnel (compte de service) ────
# Fichier de clé JSON du compte de service, jamais versionné (voir credentials/)
# Le personnel (enseignants, responsables, administrateur) vit dans UN SEUL
# Sheet fusionné — le rôle de chaque ligne vient de sa colonne "role".
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEET_ELEVES_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0000000000000000
GOOGLE_SHEET_PERSONNEL_ID=1ZyXwVuTsRqPoNmLkJiHgFeDcBa0000000000000000

# ── API FastAPI + React (seule interface depuis le retrait de Django,
# D-CEO-42/43) ────────────────────────────────────────────────────────────────
# DEBUG=true en local : accès libre disponible (HAKILI_ACCES_LIBRE), pas de
# redirection HTTPS forcée, SECRET_KEY facultative (repli de dev). Mettre
# DEBUG=false en production — le cookie de session lui-même n'a pas besoin de
# secret (clé opaque vérifiée en base, app/auth/deps.py), mais SECRET_KEY
# devient OBLIGATOIRE pour les jetons d'URL signés (app/auth/tokens.py,
# élève/copie/session jamais en clair dans un lien, D-CEO-25) : l'application
# refuse de démarrer sans, plutôt que de tourner avec la clé de repli connue
# de quiconque lit ce dépôt. Générer une clé :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=true
HAKILI_ACCES_LIBRE=false
SECRET_KEY=

# ── Base Neon (partagée par le pipeline et le backend FastAPI) ───────────────
# Convention à trois barres héritée de SQLAlchemy (sqlite:///:memory: en
# local, postgresql://...?sslmode=require en production).
DATABASE_URL=
