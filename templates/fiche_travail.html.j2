<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Fiche de travail — {{ COMPETENCE_LIBELLE }}</title>
  <style>
    @page {
      size: A4;
      margin-top: 28mm;
      margin-left: 20mm;
      margin-right: 18mm;
      margin-bottom: 22mm;

      @frame header_frame {
        -pdf-frame-content: page_header;
        left: 20mm; width: 172mm; top: 7mm; height: 16mm;
      }
      @frame footer_frame {
        -pdf-frame-content: page_footer;
        left: 20mm; width: 172mm; bottom: 5mm; height: 14mm;
      }
    }

    * { box-sizing: border-box; }
    body {
      font-family: {{ FONT_NAME }}, Helvetica, sans-serif;
      font-size: 10.5pt;
      color: #1a1a1a;
      line-height: 1.55;
    }
    p { margin: 0 0 4pt 0; }

    .hdr-left   { font-size: 9pt; font-weight: bold; color: #1A5276; padding: 0; }
    .hdr-right  { font-size: 8pt; color: #5D6D7E; text-align: right; padding: 0; }

    .info-box-bordered {
      width: 100%;
      border: 1pt solid #1A5276;
      border-collapse: collapse;
      margin-bottom: 12pt;
    }
    .info-box-bordered td { padding: 7pt 12pt; vertical-align: middle; }
    .info-name { font-size: 12.5pt; font-weight: bold; color: #1A5276; }
    .info-code { font-size: 8.5pt; color: #5D6D7E; }
    .info-meta {
      font-size: 8.5pt; color: #333; text-align: right; line-height: 1.5;
      border-left: 1pt solid #1A5276;
    }
    .type-erreur-badge {
      display: inline-block;
      background: #FDEDEC;
      color: #922B21;
      font-size: 8.5pt;
      padding: 1pt 7pt;
      margin-top: 3pt;
    }

    .section { margin-bottom: 12pt; page-break-inside: avoid; }
    .section-titre {
      font-size: 9.5pt;
      font-weight: bold;
      color: #1A5276;
      text-transform: uppercase;
      border-bottom: 0.5pt solid #C8CBD0;
      padding-bottom: 3pt;
      margin-bottom: 6pt;
    }

    .objectif-box {
      background: #EAF2FF;
      border-left: 3pt solid #2E86C1;
      padding: 7pt 10pt;
      font-size: 10pt;
    }

    ul.retenir, ul.prerequis-liste { margin: 0; padding-left: 14pt; }
    ul.retenir li, ul.prerequis-liste li { margin-bottom: 2pt; }

    .exemple-box {
      background: #F8F9F9;
      border: 0.5pt solid #C8CBD0;
      padding: 7pt 10pt;
      font-size: 10pt;
    }
    .exemple-box p { margin: 0 0 6pt 0; }
    .exemple-box p:last-child { margin-bottom: 0; }
    ul.exemple-tableau {
      margin: 4pt 0 8pt 0;
      padding-left: 14pt;
      font-size: 9pt;
    }
    ul.exemple-tableau li { margin-bottom: 3pt; }

    .erreur-ligne { font-size: 9pt; margin-bottom: 3pt; }
    .erreur-ligne .etiquette { color: #922B21; font-weight: bold; }

    table.deroule { width: 100%; border-collapse: collapse; }
    table.deroule td { border: 0.5pt solid #C8CBD0; padding: 5pt 8pt; font-size: 9pt; }
    table.deroule .minutes { width: 20mm; text-align: center; font-weight: bold; color: #1A5276; }

    .exercice-block {
      margin-bottom: 8pt;
      page-break-inside: avoid;
      border: 0.5pt solid #C8CBD0;
    }
    .exercice-entete {
      background-color: #D6EAF8;
      padding: 4pt 9pt;
      font-size: 9pt;
      font-weight: bold;
      color: #1A5276;
    }
    .exercice-enonce { padding: 6pt 9pt 4pt 9pt; font-size: 10pt; }
    .exercice-correction {
      padding: 5pt 9pt;
      font-size: 9pt;
      background: #F8F9F9;
      border-top: 0.5pt dashed #C8CBD0;
      color: #333;
    }
    .exercice-correction .etiquette { font-weight: bold; color: #1A5276; }

    .critere-box {
      background: #EAFAF1;
      border-left: 3pt solid #1E8449;
      padding: 7pt 10pt;
      font-size: 10pt;
      font-weight: bold;
      color: #196F3D;
    }

    .doc-footer {
      margin-top: 22pt;
      border-top: 0.5pt solid #ddd;
      padding-top: 5pt;
      text-align: center;
      font-size: 8pt;
      color: #7f8c8d;
      font-style: italic;
    }
  </style>
</head>
<body>

<div id="page_header">
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td class="hdr-left">PROF MAYA</td>
      <td class="hdr-right">Fiche de travail — remédiation</td>
    </tr>
  </table>
  <hr style="border:0; border-top:1.4pt solid #C0392B; margin-top:3pt;"/>
</div>

<div id="page_footer">
  <hr style="border:0; border-top:0.8pt solid #1A5276; margin-bottom:3pt;"/>
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="width:40%; text-align:left; font-size:8pt; font-weight:bold; color:#1A5276; padding:0; letter-spacing:0.2pt;">PROF MAYA</td>
      <td style="width:60%; text-align:right; font-size:8pt; color:#1A5276; padding:0;"><b>Centre d'Excellence en Mathématiques HAKILI LAB</b></td>
    </tr>
  </table>
  <p style="text-align:center; font-size:7.5pt; color:#5D6D7E; margin:2pt 0 0 0;">
    Page <pdf:pagenumber/> / <pdf:pagecount/>
  </p>
</div>

<table class="info-box-bordered">
  <tr>
    <td class="info-name">
      {{ COMPETENCE_LIBELLE }}<br/>
      <span class="info-code">{{ COMPETENCE_CODE }} &middot; {{ NIVEAU }}</span><br/>
      <span class="type-erreur-badge">{{ TYPE_ERREUR_LIBELLE }}</span>
    </td>
    <td class="info-meta">Fiche de travail<br/>{{ DATE }}</td>
  </tr>
</table>

{% if VERSION == "corrigee" %}
<div class="section" style="margin-bottom:10pt;">
  <p style="font-size:8pt; color:#5D6D7E;">Fiche corrigée par {{ CORRIGEE_PAR }} le {{ DATE_CORRECTION }} — cette version fait foi.</p>
</div>
{% endif %}

<div class="section">
  <div class="section-titre">Objectif</div>
  <div class="objectif-box">{{ OBJECTIF }}</div>
</div>

{% if PREREQUIS %}
<div class="section">
  <div class="section-titre">À vérifier en ouverture</div>
  <ul class="prerequis-liste">
    {% for p in PREREQUIS %}
    <li>{{ p.libelle }} <span style="color:#5D6D7E; font-size:8.5pt;">({{ p.code }})</span></li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% if METHODE and METHODE.etapes %}
<div class="section">
  <div class="section-titre">Méthode{% if METHODE.titre %} — {{ METHODE.titre }}{% endif %}</div>
  <ol>
    {% for etape in METHODE.etapes %}
    <li>{{ etape }}</li>
    {% endfor %}
  </ol>
</div>
{% endif %}

{% if RETENIR %}
<div class="section">
  <div class="section-titre">Ce qu'il faut retenir</div>
  <ul class="retenir">
    {% for point in RETENIR %}
    <li>{{ point }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% if EXEMPLE_RESOLU %}
<div class="section">
  <div class="section-titre">Exemple travaillé</div>
  <div class="exemple-box">{{ EXEMPLE_RESOLU }}</div>
</div>
{% endif %}

{% if ERREURS_FREQUENTES %}
<div class="section">
  <div class="section-titre">Erreurs fréquentes à surveiller</div>
  {% for e in ERREURS_FREQUENTES %}
  <div class="erreur-ligne"><span class="etiquette">{{ e.erreur }}</span> &rarr; {{ e.correction }}</div>
  {% endfor %}
  {% if DECLIC %}
  <p style="font-size:9pt; margin-top:4pt;"><strong>Point de blocage habituel :</strong> {{ DECLIC }}</p>
  {% endif %}
</div>
{% endif %}

<div class="section">
  <div class="section-titre">Déroulé de la séance</div>
  <table class="deroule">
    {% for etape in DEROULE %}
    <tr>
      <td class="minutes">{{ etape.minutes }} min</td>
      <td>{{ etape.libelle }}</td>
    </tr>
    {% endfor %}
  </table>
</div>

<div class="section">
  <div class="section-titre">Exercices gradués</div>
  {% for ex in EXERCICES %}
  <div class="exercice-block">
    {# U+2606 (étoile vide) tombe sur un glyphe manquant (carré noir) avec la
       police WinAnsi utilisée ici — n'afficher que les étoiles pleines plutôt
       que parier sur un glyphe non garanti (D-CEO-43). #}
    <div class="exercice-entete">Exercice {{ ex.numero }} &nbsp;&mdash;&nbsp; {{ ("&#9733;" * ex.etoiles) | safe }}
      <span style="font-weight:normal; color:#5D6D7E;">({{ {1: "facile", 2: "moyen", 3: "difficile"}[ex.etoiles] }})</span>
    </div>
    <div class="exercice-enonce">{{ ex.enonce }}</div>
    <div class="exercice-correction"><span class="etiquette">Corrigé (tuteur) :</span> {{ ex.correction }}</div>
  </div>
  {% endfor %}
</div>

<div class="section">
  <div class="section-titre">Critère de réussite</div>
  <div class="critere-box">{{ CRITERE_REUSSITE }}</div>
</div>

<div class="doc-footer">
  Fiche {% if VERSION == "corrigee" %}corrigée par un tuteur{% else %}générée automatiquement à partir de la banque de remédiation{% endif %} — Prof Maya.
</div>

</body>
</html>
