<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <title>Rapport diagnostique — {{ STUDENT_NAME }}</title>
  <style>
    @page {
      size: A4;
      margin-top: 28mm;
      margin-left: 20mm;
      margin-right: 18mm;
      margin-bottom: 22mm;

      @frame header_frame {
        -pdf-frame-content: page_header;
        left: 20mm; width: 172mm; top: 7mm; height: 16mm;
      }
      @frame footer_frame {
        -pdf-frame-content: page_footer;
        left: 20mm; width: 172mm; bottom: 5mm; height: 14mm;
      }
    }

    * { box-sizing: border-box; }
    body {
      font-family: {{ FONT_NAME }}, Helvetica, sans-serif;
      font-size: 10.5pt;
      color: #1a1a1a;
      line-height: 1.55;
    }
    p { margin: 0 0 4pt 0; }

    .hdr-left   { font-size: 9pt; font-weight: bold; color: #1A5276; padding: 0; }
    .hdr-right  { font-size: 8pt; color: #5D6D7E; text-align: right; padding: 0; }

    .info-box-bordered {
      width: 100%;
      border: 1pt solid #1A5276;
      border-collapse: collapse;
      margin-bottom: 12pt;
    }
    .info-box-bordered td { padding: 7pt 12pt; vertical-align: middle; }
    .info-name { font-size: 12.5pt; font-weight: bold; color: #1A5276; }
    .info-meta {
      font-size: 8.5pt; color: #333; text-align: right; line-height: 1.5;
      border-left: 1pt solid #1A5276;
    }

    .stats-box {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 14pt;
    }
    .stats-box td {
      border: 0.5pt solid #C8CBD0;
      padding: 6pt 10pt;
      text-align: center;
    }
    .stats-box .valeur { font-size: 13pt; font-weight: bold; color: #1A5276; display: block; }
    .stats-box .etiquette { font-size: 8pt; color: #5D6D7E; }

    .groupe-titre {
      background-color: #1A5276;
      color: white;
      font-weight: bold;
      font-size: 10pt;
      padding: 5pt 10pt;
      margin-top: 14pt;
      margin-bottom: 8pt;
    }

    .ligne-block {
      margin-bottom: 10pt;
      page-break-inside: avoid;
      border: 0.5pt solid #C8CBD0;
    }
    .ligne-entete {
      background-color: #D6EAF8;
      padding: 5pt 10pt;
    }
    .ligne-titre { font-weight: bold; color: #1A5276; font-size: 10.5pt; }
    .ligne-code { font-size: 8.5pt; color: #5D6D7E; }
    .ligne-cout { float: right; font-weight: bold; color: #1A5276; }
    .ligne-corps { padding: 6pt 10pt; }
    .ligne-type {
      display: inline-block;
      background: #FDEDEC;
      color: #922B21;
      font-size: 8.5pt;
      padding: 1pt 7pt;
      margin-bottom: 5pt;
    }
    .interpretation { font-size: 9pt; margin-top: 4pt; }
    .justification { font-size: 8.5pt; color: #5D6D7E; font-style: italic; margin-top: 4pt; }
    .dates { font-size: 7.5pt; color: #5D6D7E; margin-top: 4pt; }

    .doc-footer {
      margin-top: 22pt;
      border-top: 0.5pt solid #ddd;
      padding-top: 5pt;
      text-align: center;
      font-size: 8pt;
      color: #7f8c8d;
      font-style: italic;
    }
  </style>
</head>
<body>

<div id="page_header">
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td class="hdr-left">PROF MAIYA</td>
      <td class="hdr-right">Rapport diagnostique des lacunes</td>
    </tr>
  </table>
  <hr style="border:0; border-top:1.4pt solid #C0392B; margin-top:3pt;"/>
</div>

<div id="page_footer">
  <hr style="border:0; border-top:0.8pt solid #1A5276; margin-bottom:3pt;"/>
  <p style="text-align:center; font-size:8pt; font-weight:bold; color:#1A5276; margin:0;">
    PROF MAIYA &nbsp;&#8226;&nbsp; Centre d'Excellence en Mathématiques
  </p>
  <p style="text-align:center; font-size:7.5pt; color:#5D6D7E; margin:2pt 0 0 0;">
    Page <pdf:pagenumber/> / <pdf:pagecount/>
  </p>
</div>

<table class="info-box-bordered">
  <tr>
    <td class="info-name">{{ STUDENT_NAME }}</td>
    <td class="info-meta">Rapport diagnostique<br/>{{ DATE }}</td>
  </tr>
</table>

<table class="stats-box">
  <tr>
    <td><span class="valeur">{{ NB_PROBLEMES }}</span><span class="etiquette">lacune{% if NB_PROBLEMES > 1 %}s{% endif %} au total</span></td>
    <td><span class="valeur">{{ COUT_CONFIRME }} h</span><span class="etiquette">confirmé / en remédiation</span></td>
    <td><span class="valeur">{{ COUT_HYPOTHESE }} h</span><span class="etiquette">estimé, non confirmé</span></td>
  </tr>
</table>

{% if not groupes %}
<p style="color:#5D6D7E;">Aucune lacune détectée pour cette session à ce jour.</p>
{% endif %}

{% for groupe in groupes %}
<div class="groupe-titre">{{ groupe.libelle }} ({{ groupe.lignes|length }})</div>
{% for ligne in groupe.lignes %}
<div class="ligne-block">
  <div class="ligne-entete">
    <span class="ligne-cout">{{ ligne.cout }} h</span>
    <span class="ligne-titre">{{ ligne.competence_libelle }}</span>
    <span class="ligne-code">{{ ligne.competence_code }}</span>
  </div>
  <div class="ligne-corps">
    <span class="ligne-type">{{ ligne.type_erreur_libelle }}</span>

    {% if ligne.interpretation %}
    <div class="interpretation">{{ ligne.interpretation }}</div>
    {% endif %}

    {% if ligne.justification %}
    <div class="justification">« {{ ligne.justification }} »</div>
    {% endif %}

    {% if ligne.date_detection %}
    <div class="dates">
      Détectée le {{ ligne.date_detection }}{% if ligne.date_dernier_changement and ligne.date_dernier_changement != ligne.date_detection %} — dernier changement le {{ ligne.date_dernier_changement }}{% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% endfor %}
{% endfor %}

<div class="doc-footer">
  Rapport généré par Prof Maiya — diagnostic structuré (compétence × type d'erreur), sans texte libre.
</div>

</body>
</html>
